{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug sim",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/sim",
      "cwd": "${workspaceFolder}/build",
      "preLaunchTask": "make",
      "MIMode": "gdb",
      "additionalSOLibSearchPath": "${workspaceFolder}/build;${workspaceFolder}/build/lib/FMI4cpp/src",
      "symbolLoadInfo": {
        "loadAll": true
      },
      "setupCommands": [
        {
          "text": "-interpreter-exec console \"set breakpoint pending on\"",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
